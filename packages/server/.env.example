# Salin ke .env lalu isi. .env TIDAK pernah di-commit.
PORT=3000
NODE_ENV=development

# --- PostgreSQL (wajib untuk `prisma migrate` & `db:seed`) ---
# Untuk migrasi/seed pakai URL admin (superuser). Setelah F-2, URL yang dipakai
# APLIKASI sebaiknya memakai peran NOSUPERUSER (lihat README → "Peran database"),
# karena Row-Level Security tidak berlaku untuk superuser.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siwarga?schema=public&sslmode=disable
# DATABASE_URL_PRODUKSI=postgresql://siwarga_app:@localhost:5432/siwarga?schema=public&sslmode=disable

# --- Sesi ---
# 32 byte acak, base64. Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Idle timeout sesi warga (detik). Usulan §17.2 = 30 menit.
SESSION_IDLE_DETIK=1800

# --- Kripto (§14 / B17) ---
# AES-256-GCM untuk NIK & data sensitif: 32 byte acak, base64.
NIK_ENCRYPTION_KEY=

# --- Rate limit (§14.1) ---
AUTH_RATE_LIMIT_PER_MENIT=10
