  @@index([scopeLevel, scopeId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// §12.2 job queue asinkron (B26)
model NotifikasiJob {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipe      TipeNotifikasi
  channel   ChannelNotifikasi  @default(whatsapp)
  tujuan    String             @db.VarChar(20)
  payload   Json
  status    StatusNotifikasi   @default(queued)
  percobaan Int                @default(0)
  jadwalPada DateTime          @default(now()) @map("jadwal_pada") @db.Timestamptz(3)
  dikirimPada DateTime?        @map("dikirim_pada") @db.Timestamptz(3)
  galat     String?

  @@index([status, jadwalPada])
  @@map("notifikasi_job")
