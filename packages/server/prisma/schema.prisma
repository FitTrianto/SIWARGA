  scopeLevel ScopeLevel @map("scope_level")
  // null untuk scope platform
  scopeId    String?    @map("scope_id") @db.Uuid
  actorId    String     @map("actor_id") @db.Uuid
  actorRole  ActorRole  @map("actor_role")
  portal     PortalAkun
  modul      String     @db.VarChar(40)
  aksi       String     @db.VarChar(60)
