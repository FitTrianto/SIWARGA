enum ModeAksesRw {
  approval
  direct
}

enum StatusAksesRw {
  menunggu
  disetujui
  ditolak
  diakses_direct
}

model PermintaanAksesDetail {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rwId       String         @map("rw_id") @db.Uuid
  rtId       String         @map("rt_id") @db.Uuid
  // polimorfik pengurus_rw
  pengajuId  String         @map("pengaju") @db.Uuid
  lingkup    String         @db.VarChar(120)
  alasan     String?
