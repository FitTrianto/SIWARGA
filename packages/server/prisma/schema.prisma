// §9.1(6) migrasi Excel/CSV (A10)
model ImporData {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rtId         String      @map("rt_id") @db.Uuid
  fileUrl      String      @map("file_url") @db.VarChar(512)
  namaFile     String      @map("nama_file") @db.VarChar(255)
  jumlahBaris  Int         @default(0) @map("jumlah_baris")
  berhasil     Int         @default(0)
  gagal        Int         @default(0)
  laporan      Json?
  status       StatusImpor @default(proses)
